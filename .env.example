# =============================================================================
# Campify — contoh environment variable
# Salin ke `.env.local` untuk pengembangan lokal dan isi nilainya.
# Di Netlify, set variabel yang sama lewat Site settings → Environment variables.
# =============================================================================

# --- Supabase (WAJIB) --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- URL aplikasi (OPSIONAL) -------------------------------------------------
# Origin publik untuk redirect OAuth & proxy. Kosongkan saat lokal — otomatis
# memakai header host / `window.location.origin` (tanpa localhost hardcoded).
NEXT_PUBLIC_APP_URL=

# --- WhatsApp Customer Service (OPSIONAL) ------------------------------------
# Nomor CS untuk bantuan pembayaran (format internasional tanpa tanda +).
# Default contoh: 6281234567890.
NEXT_PUBLIC_CS_WHATSAPP=

# --- Midtrans Snap — PRODUCTION (WAJIB untuk pembayaran online) --------------
# Kredensial server (JANGAN pakai prefix NEXT_PUBLIC_ — rahasia).
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=
# Kredensial publik untuk skrip snap.js di browser.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/snap.js

# --- Supabase service role (WAJIB untuk webhook pembayaran) ------------------
# Dipakai route /api/webhooks/midtrans (tanpa sesi user) untuk update status
# pesanan melewati RLS. RAHASIA — jangan pernah pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Catatan pembayaran: checkout memakai Midtrans Snap (PRODUCTION) —
# tombol "Bayar Sekarang" memicu window.snap.pay(token), lalu notifikasi
# HTTP diterima di /api/webhooks/midtrans dan status pesanan diperbarui di
# Supabase (PAID / accepted untuk Jastip) berdasarkan signature_key SHA-512.
